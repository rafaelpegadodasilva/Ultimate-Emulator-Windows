{
  "name": "ultimate-emulator-windows",
  "version": "1.5.18",
  "description": "Ultimate Emulator para Windows 10/11 - Biblioteca de jogos cl\u00c3\u00a1ssicos",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"vite\" \"wait-on http://localhost:3000 && cross-env DEV_PORT=3000 electron .\"",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir"
  },
  "build": {
    "appId": "br.rafaelsilva.ultimateemulator",
    "productName": "Ultimate Emulator",
    "copyright": "Rafael Silva",
    "directories": {
      "output": "../dist-win",
      "buildResources": "build-resources"
    },
    "files": [
      "*.js",
      "*.cjs",
      "package.json",
      "renderer/**/*",
      "core-identities.json",
      "mame-machines.json"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true
    },
    "asar": true,
    "extraMetadata": {
      "main": "main.js"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "31.7.7",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron-builder": "^24.13.3",
    "vite": "^5.3.4",
    "wait-on": "^7.2.0"
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
